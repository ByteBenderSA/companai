rules_version = '2';

// CompanAI security rules.
// Every document belongs to exactly one signed-in user; nobody can read or write anyone else's data.
// Field checks are deliberately light (types + size caps) — they stop abuse and accidents
// without making legitimate edits brittle.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function shortString(v, max) {
      return v is string && v.size() <= max;
    }

    // users/{uid}: basic profile (name, email). Nothing privileged lives here.
    match /users/{uid} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
        && shortString(request.resource.data.get('name', ''), 100)
        && shortString(request.resource.data.get('email', ''), 320);
    }

    // projects/{id}: a saved idea, its prompts and build progress.
    match /projects/{projectId} {
      function validProject(d) {
        return shortString(d.title, 200)
          && shortString(d.get('description', ''), 2000)
          && d.get('features', []) is list && d.get('features', []).size() <= 30
          && d.get('techStack', []) is list && d.get('techStack', []).size() <= 20
          && d.get('completedSteps', []) is list && d.get('completedSteps', []).size() <= 10
          && d.get('prompts', {}) is map
          && shortString(d.get('prompts', {}).get('lovable', ''), 60000)
          && shortString(d.get('prompts', {}).get('cursor', ''), 60000);
      }

      allow read, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validProject(request.resource.data);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && validProject(request.resource.data);
    }

    // ideaDrafts/{uid}: the Idea Workshop's in-progress state (one per user).
    match /ideaDrafts/{uid} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.data.get('ideas', []) is list
        && request.resource.data.get('ideas', []).size() <= 5;
    }

    // userProgress/{uid}: completed lesson ids.
    match /userProgress/{uid} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['completedLessons', 'updatedAt'])
        && request.resource.data.get('completedLessons', []) is list
        && request.resource.data.get('completedLessons', []).size() <= 50;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
