{
  "name": "companai",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Open-source AI development accelerator. Turn app ideas into structured prompts for Lovable, Cursor, and other AI dev tools. BYO API key.",
  "license": "AGPL-3.0-or-later",
  "author": "CompanAI Contributors",
  "homepage": "https://github.com/ByteBenderSA/companai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByteBenderSA/companai.git"
  },
  "bugs": {
    "url": "https://github.com/ByteBenderSA/companai/issues"
  },
  "keywords": [
    "ai",
    "lovable",
    "cursor",
    "prompts",
    "firebase",
    "react",
    "typescript",
    "open-source",
    "byo-key"
  ],
  "scripts": {
    "dev": "vite",
    "dev:emulators": "vite --mode emulators",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-companai",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "node scripts/test-rules.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "firebase-tools": "^15.32.1",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
